// ==============================================================================
// SchoolOS Authoritative Prisma Schema
// Grounded in Playbook Chapters 7, 9, 12, 13, 21, 26
// ==============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ------------------------------------------------------------------------------
// Domain 1: Multi-Tenancy & School Organization [Playbook p. 11, 16, 44]
// ------------------------------------------------------------------------------

model School {
  id           String        @id @default(uuid())
  slug         String        @unique // e.g. "kings-college-lagos"
  name         String
  officialCode String?       @unique @map("official_code")
  logoUrl      String?       @map("logo_url")
  crestUrl     String?       @map("crest_url")
  currency     String        @default("NGN")
  timezone     String        @default("Africa/Lagos")
  status       String        @default("ACTIVE") // ACTIVE, TRIAL, SUSPENDED, ARCHIVED
  settings     Json          @default("{}")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  deletedAt    DateTime?     @map("deleted_at")

  campuses          Campus[]
  users             User[]
  roles             Role[]
  academicSessions  AcademicSession[]
  terms             Term[]
  classLevels       ClassLevel[]
  classArms         ClassArm[]
  subjects          Subject[]
  students          Student[]
  guardians         Guardian[]
  enrollments       EnrollmentHistory[]
  approvalRequests  ApprovalRequest[]
  auditEvents       AuditEvent[]
  securityEvents    SecurityEvent[]
  feeStructures     FeeStructure[]
  invoices          Invoice[]
  paymentRecords    PaymentTransaction[]
  refundReversals   RefundReversal[]

  @@index([status])
  @@map("schools")
}

model Campus {
  id        String   @id @default(uuid())
  schoolId  String   @map("school_id")
  name      String   // e.g. "Main Campus", "Junior Annex"
  code      String?
  address   String
  city      String
  state     String
  country   String   @default("Nigeria")
  isMain    Boolean  @default(false) @map("is_main")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  school      School       @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  classLevels ClassLevel[]

  @@unique([schoolId, name])
  @@index([schoolId])
  @@map("campuses")
}

// ------------------------------------------------------------------------------
// Domain 2: Identity, Access Control & Security [Playbook p. 10, 38-39, 44]
// ------------------------------------------------------------------------------

model User {
  id                   String    @id @default(uuid())
  schoolId             String?   @map("school_id") // NULL only for Platform SuperAdmin
  email                String
  phoneNumber          String?   @map("phone_number")
  passwordHash         String    @map("password_hash")
  firstName            String    @map("first_name")
  lastName             String    @map("last_name")
  userType             String    @map("user_type") // SUPERADMIN, OWNER, PRINCIPAL, BURSAR, TEACHER, PARENT, STUDENT
  isActive             Boolean   @default(true) @map("is_active")
  isMfaEnabled         Boolean   @default(false) @map("is_mfa_enabled")
  mfaSecretEncrypted   String?   @map("mfa_secret_encrypted")
  lastLoginAt          DateTime? @map("last_login_at")
  failedLoginAttempts  Int       @default(0) @map("failed_login_attempts")
  lockedUntil          DateTime? @map("locked_until")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  school               School?   @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  roles                UserRole[]
  formClasses          ClassArm[]           @relation("FormTeacher")
  studentProfile       Student?
  guardianProfile      Guardian?
  auditEvents          AuditEvent[]
  requestedApprovals   ApprovalRequest[]    @relation("ApprovalRequester")
  approvalSteps        ApprovalStep[]
  recordedPayments     PaymentTransaction[] @relation("PaymentRecorder")
  executedRefunds      RefundReversal[]     @relation("RefundExecutor")

  @@unique([schoolId, email])
  @@index([schoolId, email])
  @@index([userType])
  @@map("users")
}

model Role {
  id           String   @id @default(uuid())
  schoolId     String   @map("school_id")
  name         String   // e.g. "Subject Teacher", "Bursar", "Head of Year"
  isSystemRole Boolean  @default(false) @map("is_system_role")
  createdAt    DateTime @default(now()) @map("created_at")

  school      School           @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  permissions RolePermission[]
  users       UserRole[]

  @@unique([schoolId, name])
  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid())
  slug        String   @unique // e.g. "results.enter", "results.lock", "payments.reverse"
  module      String   // ACADEMICS, FINANCE, SIS, GOVERNANCE
  description String

  roles       RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String @map("role_id")
  permissionId String @map("permission_id")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Restrict)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId     String   @map("user_id")
  roleId     String   @map("role_id")
  assignedAt DateTime @default(now()) @map("assigned_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

// ------------------------------------------------------------------------------
// Domain 3: School Setup & Structure [Playbook p. 11, 16, 44]
// ------------------------------------------------------------------------------

model AcademicSession {
  id        String   @id @default(uuid())
  schoolId  String   @map("school_id")
  name      String   // e.g. "2026/2027"
  startDate DateTime @map("start_date") @db.Date
  endDate   DateTime @map("end_date") @db.Date
  isCurrent Boolean  @default(false) @map("is_current")
  createdAt DateTime @default(now()) @map("created_at")

  school School @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  terms  Term[]

  @@unique([schoolId, name])
  @@map("academic_sessions")
}

model Term {
  id        String   @id @default(uuid())
  schoolId  String   @map("school_id")
  sessionId String   @map("session_id")
  name      String   // "1st Term", "2nd Term", "3rd Term"
  startDate DateTime @map("start_date") @db.Date
  endDate   DateTime @map("end_date") @db.Date
  isCurrent Boolean  @default(false) @map("is_current")
  isLocked  Boolean  @default(false) @map("is_locked")

  school         School              @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  session        AcademicSession     @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  enrollments    EnrollmentHistory[]
  feeStructures  FeeStructure[]
  invoices       Invoice[]

  @@unique([sessionId, name])
  @@map("terms")
}

model ClassLevel {
  id         String @id @default(uuid())
  schoolId   String @map("school_id")
  campusId   String @map("campus_id")
  name       String // e.g. "JSS 1", "Basic 4", "Creche"
  levelOrder Int    @map("level_order")
  section    String // EARLY_YEARS, PRIMARY, JUNIOR_SECONDARY, SENIOR_SECONDARY

  school        School         @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  campus        Campus         @relation(fields: [campusId], references: [id], onDelete: Restrict)
  arms          ClassArm[]
  feeStructures FeeStructure[]

  @@unique([schoolId, campusId, name])
  @@map("class_levels")
}

model ClassArm {
  id            String  @id @default(uuid())
  schoolId      String  @map("school_id")
  levelId       String  @map("level_id")
  name          String  // "Gold", "Diamond", "A", "Blue"
  formTeacherId String? @map("form_teacher_id")
  capacity      Int     @default(35)

  school      School              @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  level       ClassLevel          @relation(fields: [levelId], references: [id], onDelete: Restrict)
  formTeacher User?               @relation("FormTeacher", fields: [formTeacherId], references: [id], onDelete: SetNull)
  enrollments EnrollmentHistory[]

  @@unique([levelId, name])
  @@map("class_arms")
}

model Subject {
  id         String  @id @default(uuid())
  schoolId   String  @map("school_id")
  name       String  // e.g. "Mathematics", "English Language"
  code       String  // "MTH", "ENG"
  department String? // "Science", "Humanities", "Languages"
  isElective Boolean @default(false) @map("is_elective")

  school School @relation(fields: [schoolId], references: [id], onDelete: Restrict)

  @@unique([schoolId, code])
  @@map("subjects")
}

// ------------------------------------------------------------------------------
// Domain 4: Students, Guardians & SIS [Playbook p. 11-12, 18, 44]
// ------------------------------------------------------------------------------

model Student {
  id              String   @id @default(uuid())
  schoolId        String   @map("school_id")
  userId          String?  @unique @map("user_id") // Student portal login if granted
  admissionNumber String   @map("admission_number")
  firstName       String   @map("first_name")
  lastName        String   @map("last_name")
  middleName      String?  @map("middle_name")
  gender          String   // MALE, FEMALE
  dateOfBirth     DateTime @map("date_of_birth") @db.Date
  bloodGroup      String?  @map("blood_group")
  genotype        String?
  allergies       String?
  stateOfOrigin   String?  @map("state_of_origin")
  lga             String?
  nationality     String   @default("Nigerian")
  passportUrl     String?  @map("passport_photo_url")
  status          String   @default("ACTIVE") // ACTIVE, SUSPENDED, EXPELLED, TRANSFERRED, GRADUATED, WITHDRAWN
  metadata        Json     @default("{}")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  school         School                @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  user           User?                 @relation(fields: [userId], references: [id], onDelete: SetNull)
  guardians      GuardianStudentLink[]
  enrollments    EnrollmentHistory[]
  invoices       Invoice[]
  paymentRecords PaymentTransaction[]

  @@unique([schoolId, admissionNumber])
  @@index([schoolId, lastName, firstName])
  @@index([schoolId, admissionNumber])
  @@map("students")
}

model Guardian {
  id                 String   @id @default(uuid())
  schoolId           String   @map("school_id")
  userId             String?  @unique @map("user_id")
  firstName          String   @map("first_name")
  lastName           String   @map("last_name")
  phonePrimary       String   @map("phone_primary")
  phoneSecondary     String?  @map("phone_secondary")
  email              String
  residentialAddress String?  @map("residential_address")
  occupation         String?
  createdAt          DateTime @default(now()) @map("created_at")

  school   School                @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  user     User?                 @relation(fields: [userId], references: [id], onDelete: SetNull)
  students GuardianStudentLink[]

  @@map("guardians")
}

model GuardianStudentLink {
  id                 String  @id @default(uuid())
  guardianId         String  @map("guardian_id")
  studentId          String  @map("student_id")
  relationship       String  // FATHER, MOTHER, GUARDIAN, SPONSOR
  isPrimaryContact   Boolean @default(true) @map("is_primary_contact")
  isBillingRecipient Boolean @default(true) @map("is_billing_recipient")
  hasCustody         Boolean @default(true) @map("has_custody")

  guardian Guardian @relation(fields: [guardianId], references: [id], onDelete: Cascade)
  student  Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([guardianId, studentId])
  @@map("guardian_student_links")
}

model EnrollmentHistory {
  id               String   @id @default(uuid())
  schoolId         String   @map("school_id")
  studentId        String   @map("student_id")
  classArmId       String   @map("class_arm_id")
  termId           String   @map("term_id")
  enrollmentStatus String   @default("ACTIVE") @map("enrollment_status") // ACTIVE, PROMOTED, REPEATING, WITHDRAWN
  assignedAt       DateTime @default(now()) @map("assigned_at")

  school   School   @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  student  Student  @relation(fields: [studentId], references: [id], onDelete: Restrict)
  classArm ClassArm @relation(fields: [classArmId], references: [id], onDelete: Restrict)
  term     Term     @relation(fields: [termId], references: [id], onDelete: Restrict)

  @@unique([studentId, termId])
  @@map("enrollment_history")
}

// ------------------------------------------------------------------------------
// Domain 5: Fees, Payments & Financial Ledger [Playbook p. 13, 23-24, 44]
// ------------------------------------------------------------------------------

model FeeStructure {
  id           String   @id @default(uuid())
  schoolId     String   @map("school_id")
  termId       String   @map("term_id")
  classLevelId String   @map("class_level_id")
  name         String   // e.g. "JSS 1 Tuition 2026"
  amount       Decimal  @db.Decimal(12, 2)
  currency     String   @default("NGN")
  feeCategory  String   @map("fee_category") // TUITION, BOARDING, TRANSPORT, PTA, UNIFORM
  isMandatory  Boolean  @default(true) @map("is_mandatory")
  createdAt    DateTime @default(now()) @map("created_at")

  school     School        @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  term       Term          @relation(fields: [termId], references: [id], onDelete: Restrict)
  classLevel ClassLevel    @relation(fields: [classLevelId], references: [id], onDelete: Restrict)
  items      InvoiceItem[]

  @@map("fee_structures")
}

model Invoice {
  id             String   @id @default(uuid())
  schoolId       String   @map("school_id")
  invoiceNumber  String   @unique @map("invoice_number") // e.g. "INV-2026-00452"
  studentId      String   @map("student_id")
  termId         String   @map("term_id")
  subtotalAmount Decimal  @map("subtotal_amount") @db.Decimal(12, 2)
  discountAmount Decimal  @default(0.00) @map("discount_amount") @db.Decimal(12, 2)
  totalAmount    Decimal  @map("total_amount") @db.Decimal(12, 2)
  status         String   @default("UNPAID") // UNPAID, PARTIAL, PAID, CANCELLED
  dueDate        DateTime @map("due_date") @db.Date
  createdAt      DateTime @default(now()) @map("created_at")

  school   School               @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  student  Student              @relation(fields: [studentId], references: [id], onDelete: Restrict)
  term     Term                 @relation(fields: [termId], references: [id], onDelete: Restrict)
  items    InvoiceItem[]
  payments PaymentTransaction[]

  @@map("invoices")
}

model InvoiceItem {
  id             String  @id @default(uuid())
  invoiceId      String  @map("invoice_id")
  feeStructureId String? @map("fee_structure_id")
  description    String
  amount         Decimal @db.Decimal(12, 2)

  invoice      Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  feeStructure FeeStructure? @relation(fields: [feeStructureId], references: [id], onDelete: Restrict)

  @@map("invoice_items")
}

model PaymentTransaction {
  id                String   @id @default(uuid())
  schoolId          String   @map("school_id")
  receiptNumber     String   @unique @map("receipt_number") // e.g. "REC-2026-98124"
  invoiceId         String   @map("invoice_id")
  studentId         String   @map("student_id")
  amount            Decimal  @db.Decimal(12, 2)
  paymentMethod     String   @map("payment_method") // PAYSTACK, FLUTTERWAVE, BANK_TRANSFER, POS, CASH
  providerReference String?  @unique @map("provider_reference") // Idempotency anchor
  payerName         String   @map("payer_name")
  payerPhone        String?  @map("payer_phone")
  settledAt         DateTime @default(now()) @map("settled_at")
  recordedById      String   @map("recorded_by_id")
  status            String   @default("SETTLED") // SETTLED, PENDING, FAILED, REVERSED

  school     School           @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  invoice    Invoice          @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  student    Student          @relation(fields: [studentId], references: [id], onDelete: Restrict)
  recordedBy User             @relation("PaymentRecorder", fields: [recordedById], references: [id], onDelete: Restrict)
  reversals  RefundReversal[]

  @@index([schoolId, studentId])
  @@map("payment_transactions")
}

model RefundReversal {
  id                    String   @id @default(uuid())
  schoolId              String   @map("school_id")
  originalTransactionId String   @map("original_transaction_id")
  amount                Decimal  @db.Decimal(12, 2)
  reason                String
  approvalRequestId     String   @map("approval_request_id")
  executedById          String   @map("executed_by_id")
  executedAt            DateTime @default(now()) @map("executed_at")

  school              School             @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  originalTransaction PaymentTransaction @relation(fields: [originalTransactionId], references: [id], onDelete: Restrict)
  executedBy          User               @relation("RefundExecutor", fields: [executedById], references: [id], onDelete: Restrict)

  @@map("refund_reversals")
}

// ------------------------------------------------------------------------------
// Domain 6: Governance & Maker-Checker Approvals [Playbook p. 23, 36-37, 67]
// ------------------------------------------------------------------------------

model ApprovalRequest {
  id                 String    @id @default(uuid())
  schoolId           String    @map("school_id")
  actionType         String    @map("action_type") // RESULT_CORRECTION, PAYMENT_REVERSAL, ROLE_ELEVATION, DATA_EXPORT
  approvalLevel      Int       @default(2) @map("approval_level") // 1 = Single, 2 = Dual Control, 3 = Quorum
  requesterId        String    @map("requester_id")
  targetResourceType String    @map("target_resource_type")
  targetResourceId   String    @map("target_resource_id")
  reason             String
  payloadBefore      Json      @map("payload_before")
  payloadProposed    Json      @map("payload_proposed")
  status             String    @default("PENDING_APPROVAL") // PENDING_APPROVAL, APPROVED, REJECTED, EXPIRED, EXECUTED
  expiresAt          DateTime  @map("expires_at")
  createdAt          DateTime  @default(now()) @map("created_at")
  executedAt         DateTime? @map("executed_at")

  school    School         @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  requester User           @relation("ApprovalRequester", fields: [requesterId], references: [id], onDelete: Restrict)
  steps     ApprovalStep[]

  @@map("approval_requests")
}

model ApprovalStep {
  id           String    @id @default(uuid())
  requestId    String    @map("request_id")
  stepNumber   Int       @map("step_number")
  requiredRole String    @map("required_role")
  approverId   String?   @map("approver_id")
  decision     String?   // APPROVED, REJECTED
  comments     String?
  decidedAt    DateTime? @map("decided_at")

  request  ApprovalRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  approver User?           @relation(fields: [approverId], references: [id], onDelete: Restrict)

  @@unique([requestId, stepNumber])
  @@map("approval_steps")
}

// ------------------------------------------------------------------------------
// Domain 7: Immutable Audit Logging [Playbook p. 38, 45]
// ------------------------------------------------------------------------------

model AuditEvent {
  id             String   @id @default(uuid())
  schoolId       String   @map("school_id")
  actorId        String?  @map("actor_id")
  actorIp        String   @map("actor_ip")
  actorUserAgent String?  @map("actor_user_agent")
  action         String   // e.g. "AUTH_LOGIN", "SCORE_EDIT_REQUEST", "PAYMENT_RECORDED"
  resourceType   String   @map("resource_type")
  resourceId     String?  @map("resource_id")
  beforeState    Json?    @map("before_state")
  afterState     Json?    @map("after_state")
  createdAt      DateTime @default(now()) @map("created_at")

  school School @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  actor  User?  @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([schoolId, createdAt(sort: Desc)])
  @@index([schoolId, actorId])
  @@map("audit_events")
}

model SecurityEvent {
  id         String   @id @default(uuid())
  schoolId   String   @map("school_id")
  eventType  String   @map("event_type") // FAILED_LOGIN_THRESHOLD, SUSPICIOUS_IP, BREAK_GLASS_START
  severity   String   // LOW, MEDIUM, HIGH, CRITICAL
  details    Json     @default("{}")
  createdAt  DateTime @default(now()) @map("created_at")

  school School @relation(fields: [schoolId], references: [id], onDelete: Restrict)

  @@index([schoolId, severity])
  @@map("security_events")
}
