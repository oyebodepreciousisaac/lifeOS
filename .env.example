# ==============================================================================
# SchoolOS Environment Configuration Baseline
# ==============================================================================

# Node Environment
NODE_ENV=development
PORT=3000

# App URLs
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="SchoolOS"

# Primary Database (PostgreSQL 16+)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/school_os_dev?schema=public"

# Redis Cache & Asynchronous BullMQ Queue Broker
REDIS_URL="redis://localhost:6379"

# Security & Session Authentication
SESSION_SECRET="change-this-to-a-secure-random-64-character-string-in-production"
AUTH_COOKIE_NAME="schoolos_session"

# External Payment Rails (Sandbox / Live)
PAYSTACK_SECRET_KEY="your_paystack_secret_key_here"
PAYSTACK_PUBLIC_KEY="your_paystack_public_key_here"
FLUTTERWAVE_SECRET_KEY="your_flutterwave_secret_key_here"

# Communication & Messaging Adapters
RESEND_API_KEY="your_resend_api_key_here"
DEFAULT_EMAIL_FROM="SchoolOS <notifications@schoolos.ng>"
TERMII_API_KEY="your_termii_api_key_here"
TERMII_SENDER_ID="SchoolOS"

# Object Storage (S3 / Cloudflare R2 for Private Documents & Receipts)
STORAGE_ENDPOINT="https://xxxx.r2.cloudflarestorage.com"
STORAGE_ACCESS_KEY_ID="storage_access_key"
STORAGE_SECRET_ACCESS_KEY="storage_secret_key"
STORAGE_BUCKET_NAME="school-os-private-assets"
STORAGE_REGION="auto"
